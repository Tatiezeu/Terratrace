# ══════════════════════════════════════════════════════════
# TerraTrace Frontend — Environment Configuration
# ══════════════════════════════════════════════════════════

# ── Backend API Base URL ───────────────────────────────────
VITE_API_URL=http://localhost:5001/api

# ── Google reCAPTCHA v3 ────────────────────────────────────
# Register your site at: https://www.google.com/recaptcha/admin
# Select "reCAPTCHA v3" and add "localhost" for development
# Then paste your SITE KEY here (NOT the secret key):
VITE_RECAPTCHA_SITE_KEY=6Le38wctAAAAAGk3C2s4W4WJ-kDvrEY2P4pgwxfA

# ── Cloudinary Image Uploads (optional) ───────────────────
# Sign up at: https://cloudinary.com
# Then paste your Cloud Name and an unsigned Upload Preset:
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
